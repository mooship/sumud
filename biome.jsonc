{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/.claude"],
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
    },
  },
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "linter": {
    "enabled": true,
    // Qwik rules run in ESLint (tools/lint): its type-aware valid-lexical-scope and
    // conditional-hook checks catch cases Biome's syntactic Qwik rules miss.
    "domains": {
      "qwik": "none",
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessUndefined": "error",
        "useArraySome": "error",
        "useRegexpTest": "error",
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
      },
      "performance": {
        "noDelete": "error",
      },
      "style": {
        "noNonNullAssertion": "off",
        "noCommonJs": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noSubstr": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useCollapsedIf": "error",
        "useDomQuerySelector": "error",
        "useExplicitLengthCheck": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"] },
        },
        "useForOf": "error",
        "useGlobalThis": "error",
        "useNumberNamespace": "error",
        "useThrowNewError": "error",
        "useTrimStartEnd": "error",
      },
      "suspicious": {
        "noConstantBinaryExpressions": "error",
        "noEmptyBlockStatements": "error",
        "noEmptySource": "error",
        "noExplicitAny": "off",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
      },
    },
  },
  "overrides": [
    {
      "includes": ["**/*.jsonc"],
      "json": { "formatter": { "trailingCommas": "all" } },
    },
    {
      // Generated by scripts/generate-icons.mjs from Lucide names; the Map icon shadows the global.
      "includes": ["src/components/ui/icons/**"],
      "linter": {
        "rules": { "suspicious": { "noShadowRestrictedNames": "off" } },
      },
    },
    {
      "includes": ["**/*.spec.ts", "**/*.spec.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off",
          },
        },
      },
    },
  ],
}
