{
  "name": "sumud",
  "version": "0.1.0",
  "description": "Sumud -- the story of Palestine, before 1947 and after.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run build.client && pnpm run build.server && pnpm run build.types",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "start": "vite --open --mode ssr",
    "lint": "eslint \"src/**/*.ts*\" \"*.ts\" \"adapters/**/*.ts\"",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "test": "vitest run",
    "test.coverage": "vitest run --coverage",
    "test.watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "cf-typegen": "wrangler types",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^22.19.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/coverage-istanbul": "^5.0.0",
    "clsx": "^2.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-qwik": "^1.20.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "fontaine": "^0.8.1",
    "globals": "^16.4.0",
    "happy-dom": "^20.14.0",
    "lefthook": "^2.1.12",
    "lucide-static": "^1.43.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp",
      "workerd"
    ]
  }
}
