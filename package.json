{
  "name": "sumud",
  "version": "0.1.0",
  "description": "Sumud: the story of Palestine, before 1947 and after.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "npm run build.client && npm run build.server && npm run build.types && npm run search.index",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "search.index": "pagefind --site dist",
    "dev": "vite --mode ssr",
    "preview": "npm run build && wrangler dev",
    "prepare": "lefthook install --force",
    "deploy": "npm run build && wrangler deploy",
    "start": "vite --open --mode ssr",
    "lint": "biome check . && npm run lint:qwik",
    "lint:fix": "biome check --write . && npm run lint:qwik -- --fix",
    "lint:ci": "biome ci . && npm run lint:qwik",
    "lint:qwik": "node scripts/ensure-lint.mjs && npm exec --prefix tools/lint -- eslint --max-warnings 0 src",
    "format": "biome format --write .",
    "test": "vitest run",
    "test.coverage": "vitest run --coverage",
    "test.e2e": "playwright test",
    "test.watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "cf-typegen": "wrangler types",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "clsx": "^2.1.1",
    "fontaine": "^1.0.3",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.1.12",
    "lucide-static": "^1.69.0",
    "pagefind": "^1.6.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook": true,
    "sharp": true,
    "workerd": true
  }
}
